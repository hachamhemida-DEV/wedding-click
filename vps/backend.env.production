APP_NAME="Wed In Click"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.wedinclick.com
FRONTEND_URL=https://wedinclick.com,https://www.wedinclick.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wedding_click
DB_USERNAME=wedding_user
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.wedinclick.com

SANCTUM_STATEFUL_DOMAINS=wedinclick.com,www.wedinclick.com

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

REVERB_APP_ID=123456
REVERB_APP_KEY=weddingclickkey
REVERB_APP_SECRET=weddingclicksecret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

# Cloudinary (Optional if using local storage disk)
# CLOUDINARY_URL=
